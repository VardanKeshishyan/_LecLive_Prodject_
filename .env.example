# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Set to 1 to demo UI without calling Gemini (no key required)
GEMINI_MOCK=0

# Live session (Multimodal Live API only). Use Gemini 3.x Flash Live — not the same as REST Flash.
# Default: gemini-3.1-flash-live-preview
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# REST: structured chunk notes + final summary (generateContent). Gemini 3 Flash.
# Default: gemini-3-flash-preview
# GEMINI_REST_MODEL=gemini-3-flash-preview

# Seconds of lecture audio context before consolidating into a saved block (default 180)
# GEMINI_CHUNK_INTERVAL_MS=180000
